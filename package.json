{
  "name": "@myrialabs/tunnelkit",
  "version": "0.0.15",
  "description": "Run Cloudflare Tunnels (Quick, Remote, Local) from Node or Bun — a typed API and CLI, with zero dependencies.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "tunnelkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "keywords": [
    "cloudflare",
    "cloudflared",
    "tunnel",
    "trycloudflare",
    "quick-tunnel",
    "ngrok-alternative",
    "reverse-proxy",
    "cli",
    "bun",
    "typescript"
  ],
  "author": "Myria Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myrialabs/tunnelkit.git"
  },
  "homepage": "https://github.com/myrialabs/tunnelkit#readme",
  "bugs": {
    "url": "https://github.com/myrialabs/tunnelkit/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.37.0"
  }
}
